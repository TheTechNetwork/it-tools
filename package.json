  "version": "2025.12.27-acfbb94",
  "description": "Collection of handy online tools for developers, with great UX. ",
  "author": "Corentin Th <corentin.thomasset74+it-tools@gmail.com> (https://corentin.tech)",
  "license": "GNU GPLv3",
  "repository": {
    "type": "git",
    "url": "https://github.com/CorentinTh/it-tools"
  },
  "keywords": [
    "productivity",
    "converter",
    "website",
    "vuejs",
    "tools",
    "frontend",
    "tool",
    "developer-tools",
    "developer-productivity"
  ],
  "scripts": {
    "dev": "env -u npm_config_verify_deps_before_run -u npm_config_npm_globalconfig -u npm_config__jsr_registry vite",
    "build": "vue-tsc --noEmit && env -u npm_config_verify_deps_before_run -u npm_config_npm_globalconfig -u npm_config__jsr_registry NODE_OPTIONS=--max_old_space_size=4096 vite build",
    "preview": "env -u npm_config_verify_deps_before_run -u npm_config_npm_globalconfig -u npm_config__jsr_registry vite preview --port 5050",
    "test": "npm run test:unit",
    "test:unit": "vitest --environment jsdom --run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "BASE_URL=http://localhost:5173 NO_WEB_SERVER=true playwright test",
    "test:e2e:visual": "playwright test src/visual-regression.e2e.spec.ts --project=chromium",
    "coverage": "vitest run --coverage --environment jsdom",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint src scripts worker *.ts *.mjs --no-warn-ignored",
    "cf:dev": "pnpm dlx wrangler dev",
    "cf:deploy": "pnpm dlx wrangler deploy",
    "cf:typecheck": "tsc -p worker/tsconfig.json",
    "script:create:tool": "node scripts/create-tool.mjs",
    "script:ocr:assets": "node scripts/prepare-tesseract.mjs",
    "script:ocr:sync": "node scripts/sync-ocr-assets.mjs",
    "script:figlet:fonts": "node scripts/prepare-figlet-fonts.mjs",
    "script:figlet:sync": "node scripts/sync-figlet-assets.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ./scripts/release.mjs"
  },
